# =================================================================
# ENNGA PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Security
SECRET_KEY=django-insecure-change-this-in-production-random-64-chars
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:1337,http://localhost:8080

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# OPTION 1: Docker Compose Local PostgreSQL (Default)
# Automatically populated by docker-compose if left blank:
DATABASE_URL=postgres://ennga_user:ennga_password@db:5432/ennga_db

# OPTION 2: Remote / Cloud Managed Database (AWS RDS, Supabase, Prisma, Neon, Render)
# DATABASE_URL=postgres://username:password@hostname:5432/database_name?sslmode=require

# OPTION 3: Remote MySQL (e.g. cPanel / Namecheap)
# DATABASE_URL=mysql://username:password@hostname:3306/database_name
# Or individual fields:
# DB_ENGINE=mysql
# DB_NAME=kuledwzl_ennga_db
# DB_USER=kuledwzl_ennga
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# SSH Tunnel for Remote MySQL (Optional)
USE_SSH_TUNNEL=false
SSH_HOST=premium214.web-hosting.com
SSH_PORT=21098
SSH_USER=kuledwzl
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# SSH_PASSWORD=your_ssh_password

# =================================================================
# CACHE & CELERY TASK BROKER
# =================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# =================================================================
# SEARCH ENGINE (ELASTICSEARCH)
# =================================================================
ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_USER=
ELASTIC_PASSWORD=changeme

# =================================================================
# EMAIL (MAILJET)
# =================================================================
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# =================================================================
# MEDIA STORAGE (AWS S3) - OPTIONAL
# =================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=
